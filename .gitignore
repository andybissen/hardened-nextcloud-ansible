# Patterns here are relative to THIS directory, not the repo root - so
# renaming or moving this whole directory elsewhere in (or out of) the
# repo doesn't require touching this file. Git honors a .gitignore at any
# directory level, applying it to that directory and everything below it.

# --- Real per-site config (commit only the *.example versions) ---
# These hold secrets or site-identifying values (domain, email, bucket).
group_vars/vault.yml
group_vars/all.yml
inventory.ini
# Parked copies of the above. The patterns are exact filenames, so renaming
# vault.yml out of the way (to swap in a test config, say) silently drops it
# back into git's view - as an untracked file that `git add -A` would happily
# stage. An encrypted vault.yml must never be committed either, so the
# rename must not be what un-ignores it.
group_vars/*.orig*
group_vars/*.bak

# Your actual backup-encryption public key (generate your own; see
# files/backup_public_key.asc.README). The .README stays tracked.
files/backup_public_key.asc

# --- Fetched/encrypted backups (never publish, even though encrypted) ---
backups/
*.tar.zst.gpg
*.tar.zst

# --- Ansible vault passphrase files, if you use one for unattended runs ---
.vault_pass
*.vault_pass
vault_pass.txt

# --- Ansible / tooling cruft ---
*.retry
__pycache__/
*.pyc
.ansible/

# --- Local editor / OS / Claude Code local overrides (repo-wide, not tied
# to any specific subdirectory) ---
.claude/settings.local.json
.DS_Store
